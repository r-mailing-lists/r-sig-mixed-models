>   B = list(mu = c(0, 0), V = diag(2) * 1e10),
>   R = list(V = 1, fix = 1),
>   G = list(G1 = list(V = diag(2), nu = .002))), pr=TRUE,
>   nitt = 55000, thin = 100, burnin = 5000, verbose=FALSE)
