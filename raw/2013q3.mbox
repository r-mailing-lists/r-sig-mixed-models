## [2,]   1.2322048 0.1949554 2.157951       0.9658897 0.2899341

detach(package:lme4)
library(lme4.0) # lme4.0_0.9999-1

apply(sapply(1:nsims, sim), 1, function(xx) c(mean(xx),sd(xx)))
