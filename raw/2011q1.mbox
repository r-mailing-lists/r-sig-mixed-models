>
> ? ?1L, 2L, 2L, 1L, 2L, 2L, 1L, 2L), .Label = c("f1", "f2"), class = "factor")), .Names = c("Y",
>
> "A", "B", "C", "fact"), class = "data.frame", row.names = c(NA,
>
> -24L))
>
