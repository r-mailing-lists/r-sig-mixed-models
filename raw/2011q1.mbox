  If there is overdispersion, the current advice is to fit an
observation-level random effect:

baba$obs <- 1:nrow(baba)

model_OD <-
glmer(propNb~SexA*SexB*AgeA+(1|Nest)+(1|obs),data=baba,family="binomial")


