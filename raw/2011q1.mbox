> ? ?## ? ? ? =p[i,j-1]-p[i,j]
> ? ?for (i in 1:nobs) {
> ? ? ?Cat[i]~dcat(q[i,1:(ncut+1)])
> ? ? ?## Predictions
> ? ? ?Cat.new[i]~dcat(q[i,1:(ncut+1)])
> ? ? ?q[i,1]<-1-p[i,1]
> ? ? ?for (j in 2:ncut) {
