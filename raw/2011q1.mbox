> mod2 = gls(Swiftness.1 ~ Lure + Sex + Facility.Size, data = otter)
> mod3 = gls(Swiftness.1 ~ 1, data = otter)
> mod4 =  lme(Swiftness.1 ~ Lure + Sex + Facility.Size, random =
