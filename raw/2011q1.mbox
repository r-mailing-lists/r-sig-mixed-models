mod3<-lme(y ~ a + b + c, random=~1|name/run,
          correlation=corARMA(p=2,q=1,form=~1|name/run), na.action=na.omit,
          data=eg)
AIC(mod,mod2,mod3)
plot(ACF(mod3,resType="normalized"),alpha=0.05)

