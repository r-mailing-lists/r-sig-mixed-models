> fm15 <-
> lme(fixed=MINh~((Date+DateSq)*(Cohort))+((Cohort)*Year)+Tide+
> Temp+factor(Sea)+Time.start,data=data1,
> random=~Date+DateSq|ID,corr=exp2,method="ML")
