> 
> otter$Facility.Size = factor(otter$Facility.Size)
> otter$Sex = factor(otter$Sex)
> 
> mod1 = lmer(Swiftness.1 ~ Lure + Sex + Facility.Size + (1|Subject), data 
> = otter)
> summary(mod1)
