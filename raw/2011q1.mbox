> ? ? ? ? ? ? ? ? ? ? ? ? ? ? ?beta.1=runif(1,min=0,max=1))
> ? ? ? ? ? ? ? ? ? ? ? },
> ? ? ? ? ? ? ? ? ? ? ? n.chains=3)
