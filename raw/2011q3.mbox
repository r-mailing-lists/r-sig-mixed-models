ODS SELECT Mixed.RCorr Mixed.Dimensions Mixed.FitStatistics Mixed.Tests3;

PROC MIXED DATA = UNIALZ;
    CLASS TREAT MONTH PAT;
    MODEL ADASCOG = TREAT MONTH TREAT*MONTH;
