  Here's a work-around, I think: define your interactions/nesting
explicitly.


mydata2 <- transform(mydata,
                     intab=interaction(a,b),
                     intabc=interaction(a,b,c),
                     intbc=interaction(b,c))

 lme(y~x,data=mydata2,random=list(intab=~1,intbc=~1))

