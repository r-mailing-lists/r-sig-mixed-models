MONTH? ? ? ? ? ?  5? ? ? 77? ? ? 21.55? ? <.0001
TREAT*MONTH? ? ? 10? ? ? 77? ? ?  2.08? ? 0.0357

model.cs <- update(model.un, correlation=corCompSymm(form = ~ 1 | PAT))
summary(model.cs)
anova(model.cs)

####################################
#### Mixed Model Approach (AR1) ####
####################################

#### R code and output ####

model.ar1 <- update(model.un, correlation=corAR1(form = ~ 1 | PAT))
summary(model.ar1)
anova(model.ar1)

> anova(model.ar1)
