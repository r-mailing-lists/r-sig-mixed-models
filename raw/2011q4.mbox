>
> ?d <- read.table("data.txt", header=TRUE)
> d1 <- d$d1
> d2 <- d$d2
> d3 <- d$d3
> d4 <- d$d4
> d5 <- d$d5
> ?###########################################################
> onePL <- function(b1,b2,b3,b4,b5,theta) { #nonlinear model to fit
