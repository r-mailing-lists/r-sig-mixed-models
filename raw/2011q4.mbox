> random=~(1|gr)) mcmodm<- MCMCglmm(Y ~ A, data=dataa,
> family="zipoisson", rcov=~idh(trait):units, random=~idh(trait):gr)  
> gamodm<-
> gamlss(Y ~ A + random(gr), data=dataa, family=ZIP) # For glmmadmb  
> and gamlss
