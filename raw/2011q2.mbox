> riwish.Sigma <- 4*diag(2)
> riwish.nu <- 5
> p<-dim(riwish.Sigma)[1]
>
> MCMCglmm.V <- riwish.Sigma/riwish.nu
> MCMCglmm.nu <-5
>
>> colMeans(rIW(MCMCglmm.V, MCMCglmm.nu, n=100000))
>
> [1] ?1.995096455 -0.004143937 -0.004143937 ?2.009750258
>
> riwish.Sigma /(riwish.nu ?- p - 1)
>
> ? ? [,1] [,2]
> [1,] ? ?2 ? ?0
> [2,] ? ?0 ? ?2
>
>
> Jarrod
