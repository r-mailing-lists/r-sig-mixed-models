model1.d<-lm(vals~F_humantype*F_alc,  data=fulldat)
setwd("C:\\Roger\\R_docs")
library(lme4);
fm1 <- lmer(vals ~ F_humantype+F_alc+ (1|F_ind), fulldat)
fm2 <- lmer(vals ~ F_humantype*F_alc+ (1|F_ind), fulldat)
