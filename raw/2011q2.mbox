snpmat<- data.frame(matrix(dat, ncol = 100))

names(snpmat) <- c(paste ("VR",1:100, sep='' ))

yvar <- rnorm(100, 30, 5)
covtrait <-  rnorm(100, 10, 5)

mydata <- data.frame(id, yvar, covtrait, snpmat)

#******************************mixed model in lmekin


