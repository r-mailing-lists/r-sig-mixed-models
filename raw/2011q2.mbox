 (scal|Tree) + (Asym|Tree), data = Orange, start = c(Asym = 200, xmid = 
 725, scal = 350), verbose = TRUE, nAGQ = 5)
 summary(Orange_Ascal)
 # adaptive quad: AIC = 250.2
 # Laplace: AIC = 1574



