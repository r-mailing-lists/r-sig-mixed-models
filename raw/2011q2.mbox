#*****************************************x and y variables

set.seed(3456)

dat <- sample(c(-1,0,1), 10000, replace = TRUE)

snpmat<- data.frame(matrix(dat, ncol = 100))

names(snpmat) <- c(paste ("VR",1:100, sep='' ))

