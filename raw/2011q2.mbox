for the model:

model<-MCMCglmm(cbind(pc1,pc2,pc3)~X*Y+Z,random=~us(trait):X,rcov=~us(trait):units,prior=prior,family=c("gaussian","gaussian","gaussian"),data=data,nitt=18000,burnin=3000,verbose=F)

